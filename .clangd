CompileFlags:
  CompilationDatabase: .
  Add:
    - "-std=c++17"
    - "-Ifonts"
    - "-Iimages"
    - "-Isfx"
    - "-Iexamples"
    - "-Iinclude"
    - "-Isrc"
Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add: [performance-*, modernize-*, readability-*]
    Remove: [readability-identifier-length]
